{
  "name": "faza",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "server": "tsx server/index.ts",
    "start": "npm run build && tsx server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "node scripts/check-content.mjs",
    "candidates": "node scripts/candidates.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "better-auth": "^1.7.25",
    "express": "^5.3.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "nodemailer": "^10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}