# Скопируйте в .env и заполните нужное. Файл .env не попадает в репозиторий.
# Без единой переменной сервер запускается локально: аккаунты и прогресс работают, ИИ-наставник выключен.

# --- Адрес и данные ---
# PORT=8787
# FAZA_BASE_URL=https://faza.example.org      # публичный адрес при размещении онлайн (нужен для cookie и ссылок сброса пароля)
# FAZA_DATA_DIR=data                          # папка с базой faza.db; делайте резервные копии
# FAZA_AUTH_SECRET=                           # случайная строка 32+ символов; если не задана — создаётся в папке данных
# FAZA_TRUSTED_ORIGINS=                       # дополнительные адреса интерфейса через запятую (например, прежний адрес на время переезда)
# FAZA_CANONICAL_REDIRECT=1                   # перенаправлять запросы с других адресов на FAZA_BASE_URL (после переезда на свой домен)

# --- Почта для восстановления доступа (без неё письма сохраняются в <данные>/outbox) ---
# SMTP_URL=smtps://user:password@smtp.example.org:465
# SMTP_FROM=Фаза <no-reply@example.org>

# --- Поиск источников ---
# CROSSREF_MAILTO=                            # контактный адрес для «вежливого пула» Crossref (необязательно)
# OPENALEX_API_KEY=                           # бесплатный ключ openalex.org/settings/api (необязательно)

# --- ИИ-наставник ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# Cerebras: OPENAI_BASE_URL=https://api.cerebras.ai/v1, OPENAI_MODELS=qwen-3.8-27b,gpt-oss-120b
# OPENAI_API_KEY=                             # любой сервис с интерфейсом chat/completions
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=                              # идентификаторы моделей через запятую — возьмите из документации провайдера
# AI_DAILY_LIMIT=30                           # обращений на пользователя в сутки
# AI_MAX_TOKENS=8000                          # потолок ответа (включая размышление модели)
# AI_TIMEOUT_MS=90000

# ID аккаунтов «Фазы» с доступом к агрегированному отчёту, через запятую.
FAZA_ANALYTICS_ADMIN_IDS=
